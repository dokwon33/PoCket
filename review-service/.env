# /docker-compose.yml (운영 환경 : 컨테이너 실행용 - 실제 적용값)
# /review-service/app/config/settings.py (아무 설정도 없을 경우 이 셋팅으로 동작 - 기본값)
# /review-service/.env (개발 환경 : 로컬 직접 실행용)

# 서버 설정
APP_PORT=8090
APP_NAME=review-service

# Eureka 설정
EUREKA_SERVER_URL=http://localhost:8761/eureka
EUREKA_INSTANCE_HOST=localhost

# Auth Server (JWT 검증)
JWT_ISSUER_URI=http://localhost:8080
JWK_SET_URI=http://auth-server:9000/oauth2/jwks
JWT_USER_ID_CLAIM=user_id

# 연동 서비스 URL
ENROLLMENT_SERVICE_URL=http://localhost:8083
COURSE_SERVICE_URL=http://localhost:8082

# DB (호스트에서 직접 실행할 때는 compose가 노출한 3379 포트)
DB_HOST=localhost
DB_PORT=3379
DB_NAME=lecture_db
DB_USER=manager
DB_PASSWORD=SqlDba-1
DB_ECHO=false
